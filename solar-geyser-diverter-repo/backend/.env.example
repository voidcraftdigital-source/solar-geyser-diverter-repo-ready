# Copy to .env and fill in real values before running. Never commit .env.
#
# JWT_SECRET and MANUFACTURING_KEY below MUST be at least 32 characters and
# not the placeholder text — the server now refuses to start otherwise
# (src/validateEnv.js). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each — never reuse one secret for both.

# Signs user session tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret the manufacturing/commissioning step uses to register new
# devices (Specification §22: installer-only). Not end-user-facing.
MANUFACTURING_KEY=change-me-to-a-long-random-string

# Optional — defaults shown.
PORT=8787
DB_PATH=./data.sqlite

# Comma-separated list of frontend origins allowed to call this API
# (e.g. https://your-username.github.io,https://your-app.example.com).
# Leave unset for local/dev use — the server falls back to allowing any
# origin (*) and prints a warning at startup. Set this before deploying
# publicly; never leave it wildcard in production.
# ALLOWED_ORIGINS=https://your-username.github.io

# Set to "true" only if this sits behind a reverse proxy (nginx/Caddy, or a
# hosting platform's own proxy). Needed for rate limiting below to see the
# real client IP instead of the proxy's. Leave unset for direct/local use.
# TRUST_PROXY=true

# Login/signup rate limiting — defaults shown (15 minutes, 10 login attempts,
# 20 signups). Lower LOGIN_RATE_LIMIT_MAX makes brute-forcing a password
# slower to attempt; bcrypt already makes each attempt slow, this limits how
# many attempts get through at all.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10
# SIGNUP_RATE_LIMIT_MAX=20

# Set to "true" to enable POST /api/dev/provision-device — lets the web app
# prototype provision a test device without the manufacturing key, so you can
# exercise the real pairing flow locally. Leave unset/false anywhere this
# might be reachable by anyone but you; it's a testing convenience, not a
# real device-registration path (see backend/README.md). The server prints a
# loud warning at startup whenever this is on.
ALLOW_DEV_PROVISIONING=true
